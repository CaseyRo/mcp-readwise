# Required
READWISE_TOKEN=your_readwise_access_token_here

# Required when TRANSPORT=http (MCP Portal bearer token)
MCP_API_KEY=your_mcp_portal_api_key_here

# Optional overrides
READWISE_BASE_URL=https://readwise.io
TRANSPORT=http
HOST=0.0.0.0
PORT=8000

# Optional — enables save_markdown_as_epub (all three required together)
# Your custom Readwise Library email (Reader → Account → Personalize email addresses)
READWISE_LIBRARY_EMAIL=
# Resend API key (used as SMTP password). Treat as bearer credential.
RESEND_API_KEY=
# Verified sender domain registered in Resend, e.g. mcp-readwise@yourdomain.de
EPUB_FROM_ADDRESS=
# Optional SMTP overrides (defaults shown)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
EPUB_LANG=en
